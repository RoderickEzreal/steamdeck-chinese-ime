#!/bin/sh
# 构建 fcitx5 用户态安装:~/.local/share/fcitx5-host
#
# 为什么不用 pacman 装到 /usr:
#   SteamOS 是 A/B 双分区原子更新,/usr 属于系统镜像分区,不属于任何 pacman 包
#   的文件(手动 cp 进去的、或 pacman 装的)在下一次更新时会被整块抹掉。
#   /home 是独立分区,永远保留 —— 所以整套 fcitx5 装在 /home。
#
# 装的是 SteamOS 自带的 extra-3.8 源里的官方 Arch 包(与本机 glibc/Qt 同版本,
# ABI 天然兼容),而不是 flatpak 版(flatpak 的 Qt 插件要 Qt_6.11,本机只有 6.9)。
#
# 用法:fcitx5-build-host          # 重新构建(会覆盖 $HOST)
#       fcitx5-build-host --check # 只检查不改动

set -eu

HOST="$HOME/.local/share/fcitx5-host"
CACHE="$HOME/.cache/pkgcache"
STAGE="$CACHE/stage"
PKGS="fcitx5 fcitx5-chinese-addons fcitx5-gtk fcitx5-qt fcitx5-configtool"

# 需要暴露给普通应用(通过 LD_LIBRARY_PATH)的库。
# 刻意只放 fcitx 专属的 soname —— 通用库(libuv/libopencc/libmarisa)放 private/,
# 避免污染整个会话,否则可能顶掉系统里更新版本的同名库。
EXPOSED_LIBS="libFcitx5Core libFcitx5Utils libFcitx5Config libFcitx5GClient
libFcitx5Qt6DBusAddons libFcitx5Qt6WidgetsAddons libIMECore libIMEPinyin libIMETable"

log() { echo "[fcitx5-build] $*"; }
die() { echo "[fcitx5-build][错误] $*" >&2; exit 1; }

# ---------- 1. 下载官方包 ----------
mkdir -p "$CACHE"
urls=$(pacman -Sp $PKGS 2>/dev/null | grep -E '\.pkg\.tar\.zst$' || true)
[ -n "$urls" ] || die "pacman -Sp 拿不到包 URL(离线?)"

for url in $urls; do
    f="$CACHE/$(basename "$url")"
    if [ ! -s "$f" ]; then
        log "下载 $(basename "$url")"
        curl -sSL --retry 3 -o "$f" "$url" || die "下载失败:$url"
    fi
done

# ---------- 2. 解包 ----------
log "解包到 $STAGE"
rm -rf "$STAGE"; mkdir -p "$STAGE"
for f in "$CACHE"/*.pkg.tar.zst; do
    bsdtar -xf "$f" -C "$STAGE" 2>/dev/null || die "解包失败:$f"
done
S="$STAGE/usr"
[ -d "$S" ] || die "暂存区结构异常"

# ---------- 3. 铺到 $HOST/usr (保持 Arch 目录结构) ----------
log "安装到 $HOST"
rm -rf "$HOST"
mkdir -p "$HOST/bin" "$HOST/lib" "$HOST/libexec" "$HOST/share" "$HOST/exposed"

copy_tree() { # src dst
    [ -e "$1" ] || return 0
    mkdir -p "$2"
    cp -a "$1"/. "$2"/
}

# 主程序与命令行工具
# fcitx5-config-qt 必须一起装:daemon 的托盘菜单点「配置」时走
# execvp("fcitx5-configtool") → 那个 shell 脚本再 exec fcitx5-config-qt。
# 少了它,配置界面就永远打不开。
for b in fcitx5 fcitx5-remote fcitx5-diagnose fcitx5-configtool fcitx5-migrator \
         fcitx5-config-qt fcitx5-qt6-immodule-probing \
         fcitx5-gtk3-immodule-probing fcitx5-gtk4-immodule-probing; do
    [ -f "$S/bin/$b" ] && cp -a "$S/bin/$b" "$HOST/bin/"
done
# Wayland 启动器(KWin --inputmethod= 的目标)
[ -f "$S/lib/fcitx5-wayland-launcher" ] && cp -a "$S/lib/fcitx5-wayland-launcher" "$HOST/libexec/"

# 核心库 + addon
copy_tree "$S/lib/fcitx5"        "$HOST/lib/fcitx5"
copy_tree "$S/lib/libime"        "$HOST/lib/libime"
copy_tree "$S/lib/gtk-3.0"       "$HOST/lib/gtk-3.0"
copy_tree "$S/lib/gtk-4.0"       "$HOST/lib/gtk-4.0"
copy_tree "$S/lib/qt6"           "$HOST/lib/qt6"
mkdir -p "$HOST/lib/private"
for f in "$S"/lib/*.so*; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    case "$b" in
        libmarisa*|libopencc*|libuv*|libxcb-imdkit*) cp -a "$f" "$HOST/lib/private/" ;;
        *) cp -a "$f" "$HOST/lib/" ;;
    esac
done

# 数据:addon 描述、输入法定义、词典、简繁转换
copy_tree "$S/share/fcitx5"  "$HOST/share/fcitx5"
copy_tree "$S/share/libime"  "$HOST/share/libime"
copy_tree "$S/share/opencc"  "$HOST/share/opencc"
[ -d "$S/share/table" ] && copy_tree "$S/share/table" "$HOST/share/table"
[ -d "$S/share/pinyin" ] && copy_tree "$S/share/pinyin" "$HOST/share/pinyin"

# ---------- 4. 公开库目录(给普通应用用) ----------
mkdir -p "$HOST/lib/private" "$HOST/exposed"
for f in "$HOST"/lib/*.so*; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    for pre in $EXPOSED_LIBS; do
        case "$b" in "$pre".so*) ln -sfn "$f" "$HOST/exposed/$b" ;; esac
    done
done

# ---------- 5. GTK immodules.cache ----------
# GTK3 会读 GTK_IM_MODULE_FILE 指定的 cache 文件,这样无需 sudo 就能让
# GTK 应用找到我们的 fcitx5 模块。
G3="$HOST/lib/gtk-3.0/3.0.0/immodules"
G4="$HOST/lib/gtk-4.0/4.0.0/immodules"
mkdir -p "$HOST/share/gtk-3.0" "$HOST/share/gtk-4.0"
{
    echo "# GTK+ Input Method Modules file"
    echo "# Generated by fcitx5-build-host"
    echo "# ModulesPath = $G3:$G4"
    if [ -f "$G3/im-fcitx5.so" ]; then
        echo "\"$G3/im-fcitx5.so\""
        echo "\"fcitx\" \"Fcitx 5\" \"fcitx\" \"/usr/share/locale\" \"zh:*\""
    fi
    if [ -f "$G4/libim-fcitx5.so" ]; then
        echo "\"$G4/libim-fcitx5.so\""
        echo "\"fcitx\" \"Fcitx 5\" \"fcitx\" \"/usr/share/locale\" \"zh:*\""
    fi
} > "$HOST/share/gtk-3.0/immodules.cache"
cp -f "$HOST/share/gtk-3.0/immodules.cache" "$HOST/share/gtk-4.0/immodules.cache"

# ---------- 5b. 生成中文 addon 的常驻加载覆盖 ----------
# fcitx5 的中文 addon(pinyin/cloudpinyin/table/chttrans/fullwidth/punctuation)
# 默认 OnDemand=True —— 只在「被输入法分组引用」时才加载。但分组校验发生在
# addon 加载之前,顺序一旦错开,就会看到:
#     "Group Item pinyin in group Default is not valid. Removed."
# 然后 pinyin 被踢出分组,之后谁也加不回来。
#
# 这里给它们生成 OnDemand=False 的用户态覆盖。覆盖文件是从**已安装的** .conf
# 派生的,版本号和依赖声明天然一致 —— 之前踩过的坑就是覆盖文件写着
# "core:5.1.22" 而实际装的是 5.1.14,依赖校验不过,addon 静默拒绝加载。
mkdir -p "$HOME/.local/share/fcitx5/addon"
for a in pinyin cloudpinyin chttrans table fullwidth punctuation pinyinhelper; do
    src="$HOST/share/fcitx5/addon/$a.conf"
    [ -f "$src" ] || continue
    sed 's/^OnDemand=.*/OnDemand=False/' "$src" > "$HOME/.local/share/fcitx5/addon/$a.conf"
done

# ---------- 6. 自检 ----------
log "自检"
fail=0
check() { [ -e "$1" ] && printf '  ✓ %s\n' "${1#$HOST/}" || { printf '  ✗ 缺失 %s\n' "${1#$HOST/}"; fail=1; }; }
for f in bin/fcitx5 bin/fcitx5-remote libexec/fcitx5-wayland-launcher \
         lib/fcitx5/libpinyin.so lib/fcitx5/libcloudpinyin.so lib/fcitx5/libtable.so \
         lib/fcitx5/libchttrans.so lib/fcitx5/libwayland.so lib/fcitx5/libxcb.so \
         lib/fcitx5/libxim.so lib/fcitx5/libwaylandim.so lib/fcitx5/libpinyinhelper.so \
         lib/libFcitx5Core.so.7 lib/libIMECore.so.0 share/fcitx5/addon/pinyin.conf \
         share/fcitx5/inputmethod/pinyin.conf share/fcitx5/default/zh_CN \
         share/fcitx5/default/en_US share/libime/cj.main.dict; do
    check "$HOST/$f"
done

# 链接完整性
missing=$(LD_LIBRARY_PATH="$HOST/lib:$HOST/lib/private" ldd "$HOST/bin/fcitx5" 2>/dev/null \
          | grep 'not found' | sed 's/[[:space:]]*//g' || true)
if [ -n "$missing" ]; then
    echo "  ✗ fcitx5 依赖缺失:"; echo "$missing" | sed 's/^/      /'; fail=1
else
    echo "  ✓ fcitx5 依赖完整"
fi
missing=$(LD_LIBRARY_PATH="$HOST/lib:$HOST/lib/private" ldd "$HOST/libexec/fcitx5-wayland-launcher" 2>/dev/null \
          | grep 'not found' | sed 's/[[:space:]]*//g' || true)
if [ -n "$missing" ]; then
    echo "  ✗ wayland-launcher 依赖缺失:"; echo "$missing" | sed 's/^/      /'; fail=1
else
    echo "  ✓ wayland-launcher 依赖完整"
fi

[ "$fail" = 0 ] || die "构建不完整"
log "完成:$HOST"
du -sh "$HOST" | sed 's/^/[fcitx5-build] 体积:/'
